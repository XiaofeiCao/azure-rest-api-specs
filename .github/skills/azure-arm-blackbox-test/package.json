{
  "name": "azure-arm-blackbox-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "@azure-tools/typespec-azure-core": "catalog:",
    "@azure-tools/typespec-azure-resource-manager": "catalog:",
    "@azure-tools/typespec-client-generator-core": "catalog:",
    "@typespec/compiler": "catalog:",
    "@typespec/http": "catalog:",
    "@typespec/openapi": "catalog:",
    "@typespec/rest": "catalog:",
    "@typespec/versioning": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
